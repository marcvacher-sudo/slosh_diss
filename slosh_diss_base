#include "grid/multigrid.h"
#include "navier-stokes/centered.h"
#include "two-phase.h"
#include "navier-stokes/conserving.h"
#include "navier-stokes/perfs.h"
#include "reduced.h"

double h;
double h_1;
double R;
double mu_b;
double rho_b;
double grav;

#define reduce_var 1

FILE * fpmax; //

int main() {

  L0=1.; //size of the box
  rho2 = 1.;
  rho1=1000;
  mu1 = 0.25;
  mu2 = 0.01*mu1;
  h=L0/2; 
  grav=9.81;
  
  h_1=0.02*L0; //size of the perturbation

  TOLERANCE = 1e-3 [*];
  
  /**
  Slip conditions are considered so that we measure only the dissipation generated by the bulk.
  */

  u.n[bottom] = dirichlet(0.);
  u.t[bottom] = neumann(0.);

  u.n[top] = dirichlet(0.);
  u.t[top] = neumann(0.);

  u.n[left] = dirichlet(0.);
  u.t[left] = neumann(0.);

  u.n[right] = dirichlet(0.);
  u.t[right] = neumann(0.);
 
  N=128;
  origin (-L0/2, -h);
  init_grid(N);

  #if reduce_var 
    G.y=-grav;
  #endif

  fpmax =  fopen("log_slip.dat", "w");

  run();
}

/**
The initial state is a sloshing mode $m=3$, of amplitude $h_1$.
*/

event init (t = 0) {
  mu_b=mu2/mu1;
  rho_b=rho2/rho1;
  R=h/L0;

  fraction (f, h_1*sin(3*pi*x/L0)-y);

  #if !reduce_var 
    const face vector G[] = {0,-grav};
    a=G;
  #endif
}

/**Computing total energy with potential energy having a shift to be of the same order as the kinetic energy */

event logfile (i++) { 

    double ke=0.;
  double gpe=0.;
  foreach() {
    double norm2=0.;
    foreach_dimension() {
      norm2+=sq(u.x[]);
    }
    ke+=norm2*f[]*dv();
    gpe+=y*f[]*dv();
  }
  double Ec=ke/2.;
  double Ep=grav*(gpe+L0*sq(h)/2.);

  static double E0=0.;
  if (i==10) {
    E0=Ec+Ep;
  }

  if (i>10) {
    fprintf (stderr, "%d %g %g\n", i, t,(Ec+Ep)/E0);
    fprintf (fpmax, "%d %g %g\n", i, t,(Ec+Ep)/E0);
  }
}

/**
We generate a video of the fraction to visualize the decreasing sloshing.
*/

event ppm_output (t = 0; t += 0.01; t <= 15) {

  char name[80];
  sprintf (name, "f.mp4");
  output_ppm (f, file = name, n = 512, min = 0, max = 1, linear = true);

  //u.y
  char name_u[80];
  sprintf (name_u, "u_y.mp4");
  output_ppm (u.y, file = name_u, n = 512,min = -0.3, max = 0.3, linear = true);
  
  //u.x
  char name_u_2[80];
  sprintf (name_u_2, "u_x.mp4");
  output_ppm (u.x, file = name_u_2, n = 512,min = -0.3, max = 0.3, linear = true);
}

event profile (t = end) {
  printf ("-----END-----\n");
}

